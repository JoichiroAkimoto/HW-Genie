# Set default behavior to automatically normalize line endings
* text=auto

# Binary / generated assets must not be normalized (text=auto would corrupt them)
*.gif binary linguist-generated=true
*.png binary linguist-generated=true
*.jpg binary linguist-generated=true

# Force LF for VHS tapes and shell scripts (CRLF would break vhs parsing)
*.tape text eol=lf
*.sh text eol=lf
*.envrc text eol=lf
.env text eol=lf
.env.* text eol=lf
copy.envrc text eol=lf
bin/* text eol=lf
