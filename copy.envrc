# テンプレート — 必要に応じて追記してください。
# 例: export PYTHONWARNINGS="ignore::DeprecationWarning"
PATH_add bin

# .env を読み込む (存在する場合)。Turso 接続設定等を環境変数に展開する。
if [ -f .env ]; then
  dotenv .env
fi

# Nix があれば flake (Python + uv + tooling) で環境構築、なければ従来の .venv を使う
if has nix; then
  use flake
else
  if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
  fi
fi
