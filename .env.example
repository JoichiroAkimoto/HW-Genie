# .env ファイル (Git管理対象外)
# 使用方法: このファイルをコピーして .env を作成し、必要に応じて編集してください。

# データベース接続URL
# リモート直接接続 (Turso): sqlite+libsql://[your-db].turso.io/?auth_token=[your-token]&secure=true
# ローカル Embedded Replica (Syncs): "./" 付き相対パスはプロジェクトルート(PKG_ROOT)基準で
#   解決されるため、コンテナ(/app/data)とホスト(<repo>/data)で同じ .env が使えます。
DATABASE_URL=sqlite+libsql:///./data/hw_genie.db

# Turso Embedded Replicas (Syncs) の設定
# 有効にする場合は、TURSO_SYNC_URL と TURSO_AUTH_TOKEN を設定してください。
# ローカルファイル (DATABASE_URL で指定されたパス) がレプリカとして使われ、自動的に同期されます。
# TURSO_SYNC_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
# TURSO_SYNC_INTERVAL=300  # 同期インターバル (秒、オプション)
# TURSO_SYNC_ON_CONNECT=true  # 接続時に毎回明示的に sync() する (デフォルト true)。
#   false にすると sync_interval 任せになる。短時間のCLIコマンド (例: auth --list)
#   は接続直後にクエリを投げるため、バックグラウンド同期が完了する前に古いデータを
#   読む可能性があります。常駐するコンテナ(auth-server)では false にして
#   sync_interval 任せにする方が効率的です。
# TURSO_WRITE_REMOTE=true  # 書き込みをローカルレプリカ経由ではなく「リモート直接」にする。
#   複数端末から書く場合、各端末のローカルレプリカ同士で競合するのを防ぐため推奨。
#   read は引き続きローカルレプリカ (TURSO_SYNC_ON_CONNECT で最新化)。

# 認証サーバーの設定
HW_GENIE_AUTH_PORT=8765
HW_GENIE_AUTH_HOST=127.0.0.1

# 一括実行 (multi / bin/hwda / bin/hwsa) の設定
# HWDA_MAX_PARALLEL=0  # 同時実行アカウント数の上限 (0/未設定 = アカウント数 = 事実上無制限)
# HWDA_LOG_KEEP_DAYS=7  # data/logs/ の古いログ (hwda_*.log / hwsa_*.log) の保持日数 (0 で自動削除を無効化)

# 表示タイムゾーン
# auth --list の Updated 列や一括実行の表示時刻に使用する IANA タイムゾーン名。
# DB には常に UTC で保存され、表示時のみ変換されます。未設定時は UTC。
# HWGENIE_TZ=Asia/Tokyo
