#!/bin/bash
# Run the FULL routine (hero raid + shop + daily) for ALL registered accounts
# inside a SINGLE Python process (parallel via a thread pool). Running in one
# process lets the libSQL Embedded Replica be opened concurrently without the
# multi-process WAL contention (see issue #47).
#
# Output is mirrored to data/logs/hw-genie_<timestamp>.log by the Python
# ``--log-dir`` option (log rotation handled internally).
#
# Usage:
#   bin/hwsa [ACCOUNT ...] [--parallel N]
#   (mode "full" is baked in; pass only account aliases and/or --parallel)
set -u

cd "$(dirname "$0")/.."
exec uv run --locked hw-genie multi full --log-dir data/logs "$@"
