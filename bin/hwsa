#!/bin/bash
# Run the FULL routine (hero raid + shop + daily) for ALL registered accounts
# inside a SINGLE Python process (parallel via a thread pool). Running in one
# process lets the libSQL Embedded Replica be opened concurrently without the
# multi-process `wal_insert_begin failed` WAL contention (see issue #47).
#
# This script is intended to run inside the Docker container (or locally with
# uv) where the DB (and optionally Turso Syncs) is already available.
#
# Usage:
#   bin/hwsa [ACCOUNT ...] [--parallel N]
#   (mode "full" is baked in; pass only account aliases and/or --parallel)
# Concurrency is capped by HWDA_MAX_PARALLEL (0/unset = unbounded = all at once).
#
# Output is mirrored to data/logs/hwsa_<timestamp>.log (the combined,
# interleaved log of all accounts in the single process).
set -u

cd "$(dirname "$0")/.."

LOG_DIR="data/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/hwsa_$(date '+%Y%m%d_%H%M%S').log"

echo "=== Starting parallel full routine for all accounts at $(date '+%Y-%m-%d %H:%M:%S') ===" | tee "$LOG_FILE"
uv run hw-genie multi full "$@" 2>&1 | tee -a "$LOG_FILE"
code=${PIPESTATUS[0]}
echo "=== Finished at $(date '+%Y-%m-%d %H:%M:%S') ===" | tee -a "$LOG_FILE"
echo "Log saved to $LOG_FILE"
exit $code
