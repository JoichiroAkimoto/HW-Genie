#!/bin/bash
# Run the daily routine for ALL registered accounts inside a SINGLE Python
# process (parallel via a thread pool). Running in one process lets the libSQL
# Embedded Replica be opened concurrently without the multi-process
# WAL contention (see issue #47).
#
# Output is mirrored to data/logs/hwda_<timestamp>.log via shell tee.
# Old logs are pruned by find based on HW_LOG_KEEP_DAYS (default 7).
#
# Usage:
#   bin/hwda [ACCOUNT ...] [--parallel N]
#   (mode "daily" is baked in; pass only account aliases and/or --parallel)
set -euo pipefail

cd "$(dirname "$0")/.."

# 下記の uv run は --no-sync で起動するため、.venv 未作成（クローン直後等）だと
# hw-genie が見つからず起動に失敗する。事前に uv sync を実行するよう案内して
# 早期終了する。依存更新後の未同期は本チェックでは検出されず、実行時エラー
# （ModuleNotFoundError 等）になるため、依存更新時も事前に uv sync を実行すること。
if [ ! -x .venv/bin/hw-genie ]; then
  echo "Error: .venv/bin/hw-genie が見つかりません。依存関係を同期してください:" >&2
  echo "  uv sync" >&2
  exit 1
fi

LOG_DIR="data/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/hwda_$(date '+%Y%m%d_%H%M%S').log"
# Python 側（hw-genie multi）が run_logs の log_file 列に記録するためのパス。
export HWGENIE_LOG_FILE="$LOG_FILE"

# Prune old logs. Delete hwda_/hwsa_ logs older than HW_LOG_KEEP_DAYS*24h
# (default 7; find's -mtime +N keeps roughly the last N days). Set to 0 to
# disable cleanup. Only hwda_/hwsa_ logs under LOG_DIR are touched.
KEEP_DAYS="${HW_LOG_KEEP_DAYS:-7}"
if [ -d "$LOG_DIR" ] && [ "$KEEP_DAYS" -gt 0 ] 2>/dev/null; then
  deleted=$(find "$LOG_DIR" -maxdepth 1 \( -name 'hwda_*.log' -o -name 'hwsa_*.log' \) -type f -mtime "+$KEEP_DAYS" -print -delete)
  [ -n "$deleted" ] && echo "Pruned $(echo "$deleted" | wc -l | tr -d ' ') old log(s) (older than ${KEEP_DAYS}d)"
fi

echo "=== Starting parallel daily routine for all accounts at $(date '+%Y-%m-%d %H:%M:%S') ===" | tee "$LOG_FILE"

# 依存の鮮度警告: uv に問い合わせて仮想環境が uv.lock と同期済みか確認する。
# （--dry-run はローカル検証のみでダウンロードしない。--no-sync 起動のため、
# 依存更新後は事前に `uv sync --locked` が必要。判定は uv の出力文言
# "Would make no changes" に依存し、dev 込みで同期された環境を前提とする）。
# ※ログ追記は上記 tee（上書き）より後に置くこと。警告は stderr とログの両方に残す。
state=$(uv sync --dry-run --locked 2>&1) || state=""
if [[ "$state" != *"Would make no changes"* ]]; then
  msg="Warning: 依存関係が仮想環境と未同期の可能性があります:"
  printf '%s\n  %s\n' "$msg" "uv sync --locked" >&2
  printf '%s\n  %s\n' "$msg" "uv sync --locked" >> "$LOG_FILE"
fi

code=0
# 端末直結実行時のみカラーを有効化（tee パイプで TTY 判定が false になるため FORCE_COLOR で強制）。
# 未設定時のみ設定し、ユーザーの明示的な FORCE_COLOR=0 / 空文字は尊重する（NO_COLOR は Python 側が優先）。
# ログには ANSI コードを除去したプレーンな出力を保存する（BSD sed は \x1b 非対応のため perl を使用）。
# パイプラインの終了コード伝播は冒頭の `set -euo pipefail` により有効: 左側の異常終了は
# tee の成功で隠蔽されず `|| code=$?` に正しく捕捉される。
# Finished 行は同じパイプラインに通し、perl の出力順を保証する（process substitution は
# 非同期のため、別途 tee -a で追記すると順序競合が起こる）。
# `--no-sync` は uv の起動時環境再同期（pyproject.toml / uv.lock の mtime 変化で発火し、
# 変更パッケージのダウンロード待ちが発生）をスキップして起動を即時化する。
# --no-sync 下では lockfile 検証（--locked 相当）もスキップされるため、
# 検証は事前の `uv sync` に委ねられる。依存を更新した場合は
# 事前に `uv sync` を一度実行すること（待ちは更新時のみに移る）。
if [ -t 1 ] && [ -z "${FORCE_COLOR+x}" ]; then export FORCE_COLOR=1; fi
(uv run --no-sync hw-genie multi daily "$@" 2>&1; rc=$?; echo "=== Finished at $(date '+%Y-%m-%d %H:%M:%S') ==="; exit $rc) \
  | tee >(perl -pe 'BEGIN{$|=1} s/\e\[[0-9;]*m//g' >> "$LOG_FILE") || code=$?
echo "Log saved to $LOG_FILE"
exit $code
