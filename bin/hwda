#!/bin/bash
# Run the daily routine for ALL registered accounts inside a SINGLE Python
# process (parallel via a thread pool). Running in one process lets the libSQL
# Embedded Replica be opened concurrently without the multi-process
# `wal_insert_begin failed` WAL contention (see issue #47).
#
# This script is intended to run inside the Docker container (or locally with
# uv) where the DB (and optionally Turso Syncs) is already available.
#
# Usage:
#   bin/hwda [ACCOUNT ...] [--parallel N]
#   (mode "daily" is baked in; pass only account aliases and/or --parallel)
# Concurrency is capped by HWDA_MAX_PARALLEL (0/unset = unbounded = all at once).
set -u

cd "$(dirname "$0")/.."

echo "=== Starting parallel daily routine for all accounts at $(date '+%Y-%m-%d %H:%M:%S') ==="
uv run hw-genie multi daily "$@"
code=$?
echo "=== Finished at $(date '+%Y-%m-%d %H:%M:%S') ==="
exit $code
